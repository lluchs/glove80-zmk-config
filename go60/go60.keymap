#include <behaviors.dtsi>

#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/pointing.h>

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#include "keys.dtsi"

// layers
#define LAYER_Base 0
#define LAYER_Keypad 1
#define LAYER_SymbolNav 2
#define LAYER_Mouse 3
#define LAYER_Magic 4

/ {
    input_processors {
        zip_click_to_right_click_mapper: zip_click_to_right_click_mapper {
            compatible = "zmk,input-processor-code-mapper";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            map = <INPUT_BTN_0 INPUT_BTN_1>;
        };
    };

    behaviors {
        magic: magic {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&rgb_ug_status_macro>;
        };

        keypad_td: keypad_td {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo LAYER_Keypad>, <&to LAYER_Keypad>;
        };

        symbol_nav_td: symbol_nav_td {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo LAYER_SymbolNav>, <&to LAYER_SymbolNav>;
        };

        bt_0: bt_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_0>, <&bt BT_DISC 0>;
        };
        bt_1: bt_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_1>, <&bt BT_DISC 1>;
        };
        bt_2: bt_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_2>, <&bt BT_DISC 2>;
        };
        bt_3: bt_3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_3>, <&bt BT_DISC 3>;
        };

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <RIGHT_HAND_KEYS>; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <LEFT_HAND_KEYS>; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };
    };

    macros {
        rgb_ug_status_macro: rgb_ug_status_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_STATUS>;
        };

        bt_select_0: bt_select_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 0>;
        };
        bt_select_1: bt_select_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 1>;
        };
        bt_select_2: bt_select_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 2>;
        };
        bt_select_3: bt_select_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 3>;
        };
    };

    combos {
        compatible = "zmk,combos";

#define COMBO_OPTS timeout-ms = <20>; require-prior-idle-ms = <200>;

        combo_left_shift {
            COMBO_OPTS
            key-positions = <POS_LH_C2R2 POS_LH_C2R3>;
            bindings = <&kp LSHFT>;
        };

        combo_right_shift {
            COMBO_OPTS
            key-positions = <POS_RH_C2R2 POS_RH_C2R3>;
            bindings = <&kp RSHFT>;
        };

        combo_left_mod3 {
            COMBO_OPTS
            key-positions = <POS_LH_C3R2 POS_LH_C3R3>;
            bindings = <&kp CAPS>;
        };

        combo_right_mod3 {
            COMBO_OPTS
            key-positions = <POS_RH_C3R2 POS_RH_C3R3>;
            bindings = <&kp CAPS>;
        };

        // F1 combo for Go60 - TailorKey
        combo_F1_cb_v1_TKZ {
            COMBO_OPTS
            key-positions = <POS_LH_C5R1 POS_LH_C5R2>;
            bindings = <&kp F1>;
        };

        // F2 combo for Go60 - TailorKey
        combo_F2_cb_v1_TKZ {
            COMBO_OPTS
            key-positions = <POS_LH_C4R2 POS_LH_C4R1>;
            bindings = <&kp F2>;
        };

        // F3 combo for Go60 - TailorKey
        combo_F3_cb_v1_TKZ {
            COMBO_OPTS
            key-positions = <POS_LH_C3R2 POS_LH_C3R1>;
            bindings = <&kp F3>;
        };

        // F4 combo for Go60 - TailorKey
        combo_F4_cb_v1_TKZ {
            COMBO_OPTS
            key-positions = <POS_LH_C2R2 POS_LH_C2R1>;
            bindings = <&kp F4>;
        };

        // F5 combo for Go60 - TailorKey
        combo_F5_cb_v1_TKZ {
            COMBO_OPTS
            key-positions = <POS_LH_C1R2 POS_LH_C1R1>;
            bindings = <&kp F5>;
        };

        // F6 combo for Go60 - TailorKey
        combo_F6_cb_v1_TKZ {
            COMBO_OPTS
            key-positions = <POS_RH_C1R1 POS_RH_C1R2>;
            bindings = <&kp F6>;
        };

        // F7 combo for Go60 - TailorKey
        combo_F7_cb_v1_TKZ {
            COMBO_OPTS
            key-positions = <POS_RH_C2R1 POS_RH_C2R2>;
            bindings = <&kp F7>;
        };

        // F8 combo for Go60 - TailorKey
        combo_F8_cb_v1_TKZ {
            COMBO_OPTS
            key-positions = <POS_RH_C3R1 POS_RH_C3R2>;
            bindings = <&kp F8>;
        };

        // F9 combo for Go60 - TailorKey
        combo_F9_cb_v1_TKZ {
            COMBO_OPTS
            key-positions = <POS_RH_C4R1 POS_RH_C4R2>;
            bindings = <&kp F9>;
        };

        // F10 combo for Go60 - TailorKey
        combo_F10_cb_v1_TKZ {
            COMBO_OPTS
            key-positions = <POS_RH_C5R1 POS_RH_C5R2>;
            bindings = <&kp F10>;
        };

        // F11 combo for Go60 - TailorKey
        combo_F11_cb_v1_TKZ {
            COMBO_OPTS
            key-positions = <POS_RH_C6R1 POS_RH_C6R2>;
            bindings = <&kp F11>;
        };

        // F12 combo for Go60 - TailorKey
        combo_F12_cb_v1_TKZ {
            COMBO_OPTS
            key-positions = <POS_RH_C5R1 POS_RH_C6R1>;
            bindings = <&kp F12>;
        };

    };

    keymap {
        compatible = "zmk,keymap";
        layer_Base {
            bindings = <
            &kp GRAVE  &kp N1     &kp N2       &kp N3          &kp N4  &kp N5                                                      &kp N6        &kp N7       &kp N8    &kp N9    &kp N0   &kp MINUS
              &kp TAB   &kp Q      &kp W        &kp E           &kp R   &kp T                                                       &kp Y         &kp U        &kp I     &kp O     &kp P    &kp LBKT
              &kp ESC   &kp A      &kp S        &kp D           &kp F   &kp G                                                       &kp H         &kp J        &kp K     &kp L  &kp SEMI     &kp SQT
            &kp LSHFT   &kp Z      &kp X        &kp C           &kp V   &kp B                                                       &kp N         &kp M    &kp COMMA   &kp DOT  &kp FSLH  &kp RSHFT
                    &magic LAYER_Magic 0   &keypad_td  &symbol_nav_td                                                                          &kp BSLH     &kp LGUI  &kp RBKT
                                                                   &kp BSPC  &kp DEL  &kp LCTRL            &kp LALT  &kp RET  &kp SPACE
            >;
        };

        layer_Keypad {
            bindings = <
                &none     &kp F1     &kp F2          &kp F3               &kp F4         &kp F5                                                 &kp F6     &kp F7      &kp F8        &kp F9          &kp F10     &kp F11
               &trans      &none   &kp HOME          &kp UP              &kp END      &kp PG_UP                                              &kp KP_N7  &kp KP_N8   &kp KP_N9  &kp KP_MINUS     &kp KP_SLASH     &kp F12
               &trans  &kp LC(Y)   &kp LEFT        &kp DOWN            &kp RIGHT      &kp PG_DN                                              &kp KP_N4  &kp KP_N5   &kp KP_N6   &kp KP_PLUS  &kp KP_MULTIPLY  &kp KP_NUM
               &trans  &kp LC(Z)  &kp LC(X)       &kp LC(C)            &kp LC(V)  &kp LS(LC(V))                                              &kp KP_N1  &kp KP_N2   &kp KP_N3  &kp KP_ENTER        &kp EQUAL      &trans
                       &magic LAYER_Magic 0  &to LAYER_Base  &mo LAYER_SymbolNav                                                                        &kp KP_N0  &kp KP_DOT      &kp BSPC
                                                                                    &trans  &trans  &trans              &trans  &trans  &kp KP_N0
            >;
        };

        layer_SymbolNav {
            bindings = <
              &kp INS    &kp F1     &kp F2    &kp F3          &kp F4     &kp F5                                       &kp F6     &kp F7           &kp F8       &kp F9          &kp F10    &kp F11
             &kp SLCK  &kp EXCL   &kp HOME    &kp UP         &kp END  &kp PG_UP                                   &kp K_CALC  &kp PG_UP           &kp UP    &kp PG_DN        &kp PSCRN    &kp F12
               &trans    &kp AT   &kp LEFT  &kp DOWN       &kp RIGHT  &kp PG_DN                                     &kp HOME   &kp LEFT         &kp DOWN    &kp RIGHT          &kp INS     &trans
               &trans  &kp HASH   &kp LBKT  &kp RBKT        &kp LBRC   &kp RBRC                                      &kp END   &kp STAR        &kp UNDER     &kp PLUS        &kp LSHFT  &kp LCTRL
                      &magic LAYER_Magic 0  &kp CARET  &to LAYER_Base                                                             &trans  &kp LC(LS(TAB))  &kp LC(TAB)
                                                                         &trans  &trans  &trans       &trans  &trans  &trans
            >;
        };

        layer_Mouse {
            bindings = <
 &trans  &trans  &trans  &trans  &trans  &trans                                           &trans  &trans  &trans  &trans  &trans  &trans
 &trans  &trans  &trans  &trans  &trans  &trans                                           &trans  &trans  &trans  &trans  &trans  &trans
 &trans  &trans  &trans  &trans  &trans  &trans                                           &trans  &trans  &trans  &trans  &trans  &trans
 &trans  &trans  &trans  &trans  &trans  &trans                                           &trans  &trans  &trans  &trans  &trans  &trans
                 &trans  &trans  &trans                                                           &trans  &trans  &trans
                                         &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &mkp MCLK
            >;
        };

        layer_Magic {
            bindings = <
  &bt BT_CLR     &kp C_BRI_DN     &kp C_BRI_UP       &kp C_PREV       &kp C_NEXT         &kp C_PP                                &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP   &none   &none   &bt BT_CLR_ALL
 &bootloader  &rgb_ug RGB_SPI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &rgb_ug RGB_TOG                                     &none         &none         &none   &none   &none      &bootloader
  &sys_reset  &rgb_ug RGB_SPD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &rgb_ug RGB_EFF                                     &none         &none         &none   &none   &none       &sys_reset
       &none            &none            &bt_0            &bt_1            &bt_2            &bt_3                                     &none         &none         &none   &none   &none            &none
                                         &none     &out OUT_USB            &none                                                                    &none         &none   &none
                                                                                            &none   &none   &none     &none   &none   &none
            >;
        };

    };
};

&cirque_rh_listener {
    input-processors = <&zip_xy_scaler 3 1>, <&zip_temp_layer LAYER_Mouse 1000>;
    layer_2 {
        layers = <2>;
        input-processors = <&zip_xy_scaler 9 1>;
    };
};

&cirque_lh_listener {
    input-processors = <&zip_xy_to_scroll_mapper>, <&zip_xy_scaler 1 1>, <&zip_click_to_right_click_mapper>;
    layer_4 {
        layers = <4>;
        input-processors = <&zip_xy_scaler 3 1>;
    };
};
